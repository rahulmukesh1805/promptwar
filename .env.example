# HealthBridge AI Environment Variables
# For Hackathon evaluation, DEMO_MODE=true works out-of-the-box without any external API keys.

# AI LLM Provider Key (Optional: Google Gemini or OpenAI-compatible endpoint)
AI_API_KEY=
GEMINI_API_KEY=

# OCR Provider (Optional: Google Cloud Vision / AWS Textract / Tesseract)
OCR_API_KEY=

# Multilingual Translation API (Optional: Google Cloud Translate / Azure Cognitive Services)
TRANSLATION_API_KEY=

# Database Connection (Default: local SQLite database)
DATABASE_URL=sqlite:///./healthbridge.db

# Demo Mode toggle: true | false
DEMO_MODE=true
PORT=8000
